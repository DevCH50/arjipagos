# Plataforma mínima iOS 15.0 (requerido por Firebase SDK 12.x)
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

install! 'cocoapods', :warn_for_unused_master_specs_repo => false

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Forzar deployment target mínimo a 13.0 en todos los pods
    # para evitar warnings de linking con Flutter que requiere iOS 13.0
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
      # objective_c es un native asset de Flutter (XCFramework precompilado),
      # no un pod. El fix real está en el Run Script del Runner target (abajo).
      # Estas settings aplican solo por si CocoaPods lo gestiona en el futuro.
      if target.name == 'objective_c'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
        config.build_settings['DWARF_DSYM_FILE_SHOULD_ACCOMPANY_PRODUCT'] = 'NO'
      else
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end

      # firebase_core 4.x puede contener warnings de terceros que no podemos corregir.
      # Se suprimen para mantener builds limpios.
      if target.name == 'firebase_core'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      # share_plus 12.x usa keyWindow (deprecated iOS 13) en su plugin Objective-C.
      # No se puede corregir directamente en código de terceros.
      # Se suprimen warnings hasta migrar a share_plus 13.x.
      if target.name == 'share_plus'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      # firebase_messaging 16.x contiene warnings en su plugin Obj-C (FLTFirebaseMessagingPlugin.m).
      # No se pueden corregir en código de terceros.
      if target.name == 'firebase_messaging'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      # flutter_local_notifications 21.x contiene warnings en su plugin Obj-C.
      # No se pueden corregir en código de terceros.
      if target.name == 'flutter_local_notifications'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      # flutter_secure_storage_darwin 0.3.x: warning Swift var/let en FlutterSecureStorage.swift.
      # No se puede corregir en código de terceros.
      if target.name == 'flutter_secure_storage_darwin'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      # webview_flutter_wkwebview 3.25.x: SecTrustGetCertificateAtIndex deprecated iOS 15.
      # API aún funcional; se suprime hasta que el paquete migre a SecTrustCopyCertificateChain.
      if target.name == 'webview_flutter_wkwebview'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      # open_filex 4.7.0 (última publicada, sin fix upstream) arrastra dos warnings
      # en OpenFilePlugin.m: keyWindow deprecado (iOS 13) y una función sin prototipo.
      # El keyWindow vive en la rama else de un @available(iOS 13, *), así que nunca
      # se ejecuta en los dispositivos que soportamos (mínimo iOS 15); el compilador
      # avisa igual porque compila ambas ramas. Revisar si el paquete publica 4.8.x.
      if target.name == 'open_filex'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end
    end
  end

  # Fix definitivo para el error de dSYM de objective_c.framework en App Store Connect.
  # objective_c.framework es un native asset de Flutter (binario precompilado sin dSYM).
  # Este script agrega una fase al target Runner que genera el dSYM faltante en cada
  # build/archive, satisfaciendo la validación de UUIDs de App Store Connect.
  runner_project = installer.aggregate_targets.first.user_project
  runner_target = runner_project.targets.find { |t| t.name == 'Runner' }

  if runner_target
    phase_name = 'Generate dSYM for objective_c native asset'
    existing_phase = runner_target.shell_script_build_phases.find { |p| p.name == phase_name }

    phase = existing_phase || runner_target.new_shell_script_build_phase(phase_name)

    # Siempre actualizar el script y settings para que pod install los mantenga al día
    phase.shell_script = <<~'SCRIPT'
      # Genera dSYM para objective_c.framework (native asset Flutter precompilado).
      # Sin este script, App Store Connect rechaza el archive por UUID de dSYM faltante.
      FRAMEWORK_BINARY="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}/objective_c.framework/objective_c"
      DSYM_OUTPUT="${DWARF_DSYM_FOLDER_PATH}/objective_c.framework.dSYM"
      if [ -f "$FRAMEWORK_BINARY" ]; then
        dsymutil "$FRAMEWORK_BINARY" -o "$DSYM_OUTPUT" 2>/dev/null || true
      fi
    SCRIPT
    phase.run_only_for_deployment_postprocessing = '0'
    # Marcar como "siempre ejecutar" para suprimir el warning de Xcode:
    # "Run script phase will be run during every build because it does not specify any outputs"
    phase.always_out_of_date = '1'

    # --- Blindaje permanente de LastUpgradeCheck = 2630 ---
    # `flutter build ios` / `flutter run` degradan LastUpgradeCheck a 1510 porque
    # Flutter 3.x no reconoce Xcode 26.3 (2630). Como `pod install` corre DESPUÉS
    # de esa degradación, aquí lo restauramos al valor correcto en cada build.
    runner_project.root_object.attributes['LastUpgradeCheck'] = '2630'

    runner_project.save
    puts "✔ Run Script '#{phase_name}' configurado en Runner"
    puts "✔ LastUpgradeCheck fijado en 2630 (project.pbxproj)"
  end

  # --- Blindaje permanente de LastUpgradeVersion = "2630" en el scheme ---
  # El scheme es un XML aparte que Flutter también degrada a 1510. Se corrige
  # por texto porque no lo gestiona el objeto de proyecto de xcodeproj.
  scheme_path = File.join(runner_project.path.to_s, 'xcshareddata', 'xcschemes', 'Runner.xcscheme')
  if File.exist?(scheme_path)
    original = File.read(scheme_path)
    fixed = original.gsub(/LastUpgradeVersion = "\d+"/, 'LastUpgradeVersion = "2630"')
    if fixed != original
      File.write(scheme_path, fixed)
      puts "✔ LastUpgradeVersion fijado en 2630 (Runner.xcscheme)"
    end
  end

  # --- Blindaje permanente de la plataforma iOS del Swift Package generado ---
  # Flutter regenera FlutterGeneratedPluginSwiftPackage/Package.swift con el default
  # .iOS("13.0"), pero Firebase (firebase-core / firebase-messaging) exige iOS 15.0.
  # La corrección de Flutter (updateMinimumDeployment) SOLO se aplica al hacer
  # `flutter build ios` por CLI; al compilar desde Xcode (flutter assemble) NO se aplica,
  # así que el flujo `flutter pub get` → `pod install` → build en Xcode deja 13.0 y falla
  # la resolución de paquetes. Aquí forzamos 15.0 en cada `pod install` (que es parte del
  # flujo manual y de todo `flutter build`), garantizando que Xcode siempre resuelva bien.
  spm_manifest = File.join(__dir__, 'Flutter', 'ephemeral', 'Packages', 'FlutterGeneratedPluginSwiftPackage', 'Package.swift')
  if File.exist?(spm_manifest)
    manifest = File.read(spm_manifest)
    # Sube cualquier .iOS("10..14.x") a 15.0; nunca degrada 15.0 o superior.
    patched = manifest.gsub(/\.iOS\("1[0-4](?:\.\d+)?"\)/, '.iOS("15.0")')
    if patched != manifest
      File.write(spm_manifest, patched)
      puts "✔ FlutterGeneratedPluginSwiftPackage forzado a iOS 15.0"
    end
  end
end
